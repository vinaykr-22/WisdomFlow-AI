{
  "manifest_version": 3,
  "name": "WisdomFlow Web Clipper",
  "version": "1.0",
  "description": "Clip web pages directly to your WisdomFlow AI workspace.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
